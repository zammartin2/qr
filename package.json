{
  "name": "@fab-orbita/qr",
  "version": "1.1.1",
  "description": "Zero-dependency QR code generator (ISO/IEC 18004) for Node.js, browsers and edge runtimes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": {
        "types": "./dist/index.node.d.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      },
      "workerd": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs"
      },
      "edge-light": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs"
      },
      "edge-runtime": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs"
      },
      "deno": {
        "types": "./dist/index.node.d.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      },
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs"
      },
      "node": {
        "types": "./dist/index.node.d.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "./node": {
      "types": "./dist/index.node.d.ts",
      "import": "./dist/index.node.js",
      "require": "./dist/index.node.cjs"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "import": "./dist/index.browser.js",
      "require": "./dist/index.browser.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
  "dist/**/*.js",
  "dist/**/*.cjs",
  "dist/**/*.d.ts",
  "dist/**/*.d.cts",
  "docs",
  "README.md",
  "README.ru.md",
  "LICENSE",
  "CHANGELOG.md"
 ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bundle": "node scripts/smoke-bundle.mjs",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs:check": "typedoc --entryPoints src/index.ts --emit none --validation.notDocumented --treatWarningsAsErrors",
    "size": "size-limit",
    "analyze": "node scripts/analyze.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "gen:ec-table": "node scripts/gen-ec-table.mjs",
    "gen:kanji-map": "node scripts/gen-kanji-map.mjs",
   "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:bundle && npm run analyze",
   "gen:check": "node scripts/gen-ec-table.mjs --check && node scripts/gen-kanji-map.mjs --check"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "iso-18004",
    "zero-dependencies",
    "typescript",
    "fab-orbita",
    "devorbit"
  ],
  "author": {
    "name": "Фабрициус Владимир Николаевич",
    "email": "Director@devorbit.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zammartin2/qr.git"
  },
  "homepage": "https://github.com/zammartin2/qr#readme",
  "bugs": {
    "url": "https://github.com/zammartin2/qr/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@size-limit/file": "^11.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.0.0",
    "happy-dom": "^15.0.0",
    "prettier": "^3.0.0",
    "qrcode": "^1.5.4",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.27.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "250 KB"
    },
    {
      "path": "dist/index.node.js",
      "limit": "250 KB"
    },
    {
      "path": "dist/index.browser.js",
      "limit": "250 KB"
    }
  ]
}
